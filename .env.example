# Copy to .env and fill in to get alerts in Telegram.
# Without these two values the project runs and writes the alerts to the log.
#
# Token: talk to @BotFather, /newbot, copy the token it gives you.
# Chat id: send your bot any message, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and take result[0].message.chat.id from the response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
